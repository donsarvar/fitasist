rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profile and personal data isolation rule
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Sub-collections under user document
      match /{subcollection=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
