    background-color: var(--color-background);
    color: var(--color-text-primary);
    font-family: var(--font-sans);
    -webkit-font-smoothing: antialiased;
  }
  body {
    font-feature-settings: "cv02", "cv03", "cv04", "cv11";
  }
  
  /* Auto style inputs/selects for dark mode globally */
  .dark input:not(.bg-transparent):not([type="checkbox"]):not([type="radio"]), 
  .dark select, 
  .dark textarea {
    background-color: #15161f;
    color: #f8fafc;
    border-color: rgba(255, 255, 255, 0.08);
  }
}

@utility border-brand {
  border-color: var(--brand);
}
@utility gradient-primary {
  background-image: var(--gradient-primary);
}
@utility gradient-mesh {
  background-image: var(--gradient-mesh);
}
@utility text-gradient-primary {
  background-image: var(--gradient-primary);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}
@utility shadow-hero {
  box-shadow: var(--shadow-hero);
}
@utility shadow-card {
  box-shadow: var(--shadow-card);
}
@utility shadow-soft {
  box-shadow: var(--shadow-soft);
}
@utility shadow-button {
  box-shadow: var(--shadow-button);
}
@utility glass-header {
  background-color: rgba(255, 255, 255, 0.85);
  backdrop-filter: saturate(180%) blur(24px);
  -webkit-backdrop-filter: saturate(180%) blur(24px);
  border-bottom: 1px solid rgba(0, 0, 0, 0.04);
  padding-top: calc(12px + env(safe-area-inset-top, 0px));

  :is(.dark *) & {
    background-color: rgba(18, 19, 26, 0.8);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }
}
@utility glass-nav {
  background-color: rgba(255, 255, 255, 0.9);
  backdrop-filter: saturate(180%) blur(20px);
  -webkit-backdrop-filter: saturate(180%) blur(20px);

  :is(.dark *) & {
    background-color: rgba(18, 19, 26, 0.85);
  }
}

@keyframes ai-pulse {
  0%,
  100% {
    transform: scale(1);
    opacity: 0.9;
  }
  50% {
    transform: scale(1.08);
    opacity: 1;
  }
}
@keyframes ai-ring {
  0% {
    transform: scale(0.8);
    opacity: 0.6;
  }
  100% {
    transform: scale(1.8);
    opacity: 0;
  }
}
@keyframes wave {
  0% {
    transform: translateX(0);
  }
  100% {
    transform: translateX(-50%);
  }
}
@keyframes floaty {
  0%,
  100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-6px);
  }
}
@keyframes slide-down {
  from {
    transform: translateY(-120%);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}
@keyframes confetti-fall {
  0% {
    transform: translateY(-20vh) rotate(0);
    opacity: 1;
  }
  100% {
    transform: translateY(110vh) rotate(720deg);
    opacity: 0;
  }
}
@keyframes fade-in {
  from {
    opacity: 0;
    transform: translateY(8px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.animate-ai-pulse {
  animation: ai-pulse 3.2s ease-in-out infinite;
}
.animate-ai-ring {
  animation: ai-ring 2.4s ease-out infinite;
}
.animate-floaty {
  animation: floaty 4s ease-in-out infinite;
}
.animate-slide-down {
  animation: slide-down 0.45s cubic-bezier(0.16, 1, 0.3, 1);
}
.animate-fade-in {
  animation: fade-in 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}
.animate-wave {
  animation: wave 6s linear infinite;
}

